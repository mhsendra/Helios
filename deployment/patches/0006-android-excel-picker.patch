+                                intent.addCategory(Intent.CATEGORY_OPENABLE);
+                                intent.setType(
+                                    "application/vnd.openxmlformats-officedocument."
+                                    + "spreadsheetml.sheet");
+                                startActivityForResult(intent, HELIOS_EXCEL_REQUEST);
