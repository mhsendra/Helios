+                originalName = originalName.replace("\r", " ")
+                                           .replace("\n", " ");
+
+                heliosExcelWriteResult(
+                    id, "OK", target.getAbsolutePath(), originalName);
+            } catch (Exception e) {
+                Log.e(TAG, "Error copiando Excel", e);
+                heliosExcelWriteResult(id, "ERROR", e.toString(), "");
+            } finally {
+                heliosExcelHandler.post(
+                    () -> heliosExcelRequestId = null);
+            }
+        }, "HeliosExcelCopy").start();
