+                        }
+                    }
+                }
+            } catch (Exception e) {
+                Log.e(TAG, "Error comprobando solicitud Excel", e);
+            } finally {
+                heliosExcelHandler.postDelayed(this, 300);
+            }
+        }
+    };
+
+    private void heliosExcelWriteResult(String id, String status, String detail, String originalName) {
+        try {
+            File directory = new File(getFilesDir(), "helios_excel");
+            if (!directory.exists() && !directory.mkdirs()) {
+                throw new java.io.IOException("No se puede crear directorio Excel");
+            }
+            File temporary = new File(directory, "excel_result.tmp");
+            File result = new File(directory, "excel_result.txt");
+            try (FileOutputStream output = new FileOutputStream(temporary)) {
+                String message = id + "\n" + status + "\n" + detail + (originalName.isEmpty() ? "" : "\n" + originalName);
+                output.write(message.getBytes(StandardCharsets.UTF_8));
+                output.getFD().sync();
+            }
+            if (!temporary.renameTo(result)) {
+                throw new java.io.IOException("No se puede publicar resultado Excel");
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Error escribiendo resultado Excel", e);
+        }
+    }
+
+    private void heliosExcelHandleResult(int resultCode, Intent data) {
+        final String id = heliosExcelRequestId;
+        if (id == null) {
+            return;
+        }
+        if (resultCode != Activity.RESULT_OK || data == null
